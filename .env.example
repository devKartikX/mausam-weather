# ==============================================================================
# Mausam Environment Configuration Template
# Copy this file to .env.local for local overrides.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Frontend Configuration (Render Static Site / Vite)
# In production, set to your Render backend Web Service HTTPS URL:
# e.g. VITE_API_BASE_URL=https://mausam-backend.onrender.com
# For local development with Vite proxy, leave empty or set to:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Backend Configuration (Render Web Service / FastAPI)
# Allowed frontend origins for CORS (comma-separated if multiple):
# e.g. FRONTEND_URL=https://mausam-frontend.onrender.com
FRONTEND_URL=

# Port assigned automatically by Render in production (defaults to 8000 locally):
PORT=8000
